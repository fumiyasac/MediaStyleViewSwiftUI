# アプリ実行環境 (development / production)
APP_ENV=development
# API 公開ポート
HTTP_PORT=8080

# MySQL 接続情報（compose では api は MYSQL_HOST=mysql を使うため、ここでの MYSQL_HOST は
# ホストから直接 go run する場合に利用する）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=recipe_calendar
MYSQL_USER=recipe
MYSQL_PASSWORD=recipe_password
# MySQL コンテナの root パスワード（healthcheck/管理用）。実運用では必ず変更すること。
MYSQL_ROOT_PASSWORD=root_password

# ホスト公開ポート（既定 8080。衝突時に変更）
API_HOST_PORT=8080
